<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net8.0</TargetFramework>
    <Nullable>disable</Nullable>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <AssemblyName>4OutOMTMatrix</AssemblyName>
    <RootNamespace>OMTMatrix</RootNamespace>
    <Product>4 Out OMT Matrix</Product>
    <AssemblyTitle>4 Out OMT Matrix</AssemblyTitle>
    <Company>Stockwerk Orange</Company>
    <Version>1.2.0</Version>
    <InvariantGlobalization>true</InvariantGlobalization>
    <NoWarn>$(NoWarn);CS0168;CS0219;CS0162;CS0414;CS0649;CS0169;CA1416;SYSLIB0011;SYSLIB0014;SYSLIB0006;CA2200</NoWarn> <!-- warnings from the vendored libomtnet -->
  </PropertyGroup>
  <ItemGroup>
    <Compile Remove="test/**;launcher/**" />
    <EmbeddedResource Include="panel.html" LogicalName="panel.html" />
  </ItemGroup>
</Project>
